---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Newsletter from '../components/Newsletter.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const [featured, ...rest] = posts;
---

<!doctype html>
<html lang="vi">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				max-width: var(--reading);
				padding-block: clamp(4.5rem, 11vw, 8rem) clamp(2.5rem, 6vw, 4rem);
			}
			.hero h1 {
				margin: 1rem 0 1.5rem;
				font-family: var(--mono);
				font-weight: 400;
				font-size: clamp(2.6rem, 8vw, 4.5rem);
				line-height: 1.04;
				letter-spacing: 0.02em;
				text-transform: lowercase;
			}
			.hero h1 em {
				font-style: normal;
				color: var(--accent);
			}
			.featured {
				margin-bottom: clamp(2rem, 5vw, 3.5rem);
			}
			.featured a {
				display: block;
				text-decoration: none;
			}
			.featured img {
				width: 100%;
				border-radius: var(--radius-card);
				box-shadow: var(--shadow-lift);
				transition: transform 0.25s var(--ease-out);
			}
			.featured a:hover img {
				transform: translateY(-2px);
			}
			.featured .title {
				margin-top: 1.25rem;
				font-size: clamp(1.4rem, 3vw, 2rem);
			}
			.featured a:hover .title {
				color: var(--accent);
			}
			.featured .date {
				margin: 0.35rem 0 0;
				color: var(--muted);
			}
			.posts-heading {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1rem;
				margin-bottom: 0.5rem;
				border-top: 1px solid var(--line);
				padding-top: 2rem;
			}
			.posts-heading h2 {
				margin: 0;
				font-size: 1.5rem;
			}
			.posts-heading .hand {
				font-size: 1.3rem;
			}
			.posts-heading a {
				font-family: var(--mono);
				font-size: 0.7rem;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				text-decoration: none;
			}
			section.posts {
				margin-bottom: clamp(3rem, 7vw, 5rem);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<p class="eyebrow">blog.dh6k.vip</p>
				<h1>dh6k<em>'s blog</em></h1>
				<p class="lede">{SITE_DESCRIPTION}</p>
			</section>
			{featured && (
				<section class="featured">
					<a href={`/blog/${featured.id}/`}>
						{featured.data.heroImage && (
							<Image width={1020} height={510} src={featured.data.heroImage} alt="" />
						)}
						<h2 class="title">{featured.data.title}</h2>
						<p class="date">
							<FormattedDate date={featured.data.pubDate} />
						</p>
					</a>
				</section>
			)}
			<section class="posts">
				<div class="posts-heading">
					<h2>Bài viết <span class="hand">mới nhất</span></h2>
					<a href="/blog">Tất cả →</a>
				</div>
				<ul class="row-list">
					{rest.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>{post.data.title}</a>
							<span class="row-date">
								<FormattedDate date={post.data.pubDate} />
							</span>
						</li>
					))}
				</ul>
			</section>
			<Newsletter />
		</main>
		<Footer />
	</body>
</html>
